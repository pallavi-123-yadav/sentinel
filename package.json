{
  "name": "sentinel",
  "version": "0.1.0",
  "description": "Guardian: a security scanner for AI-generated code. Catches hardcoded secrets and missing auth checks before they ship.",
  "main": "src/scanner/secret-scanner.js",
  "bin": {
    "sentinel-scan": "bin/sentinel-scan.js"
  },
  "scripts": {
    "scan": "node src/scanner/secret-scanner.js",
    "check-packages": "node src/scanner/package-checker.js",
    "cli": "node bin/sentinel-scan.js",
    "webhook": "node src/webhook/server.js",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "security",
    "static-analysis",
    "secret-scanning",
    "ai-coding"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6"
  }
}

# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real secrets here.

# Port the webhook server listens on.
PORT=4000

# Shared secret you choose and configure on the GitHub webhook
# (repo Settings > Webhooks > Secret). Used to verify that incoming
# requests actually came from GitHub.
GITHUB_WEBHOOK_SECRET=changeme

# A GitHub personal access token (repo scope) or GitHub App installation
# token. Used to clone the repo being scanned and to post the PR comment.
GITHUB_TOKEN=ghp_your_token_here
